-
-for group in GROUPS:
-    runs = api.runs(f"{ENTITY}/{PROJECT}", filters={"group": group})
-    for run in runs:
-        cfg = run.config
-        summary = run.summary._json_dict
-        rows.append({
-            "run_name": run.name,
-            "group": group,
-            "state": run.state,
-            "env_id": cfg.get("env_id"),
