#!/bin/bash
#SBATCH --job-name=sokoban_seq
#SBATCH --output=logs/slurm_seq_%j.out
#SBATCH --error=logs/slurm_seq_%j.err
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --account=cs-503

set -euo pipefail

source ~/.bashrc
conda activate cs503_proj

cd "$SLURM_SUBMIT_DIR"
mkdir -p logs figures checkpoints

export ENV_ID="${ENV_ID:-Sokoban-small-v0}"
export TOTAL_TIMESTEPS="${TOTAL_TIMESTEPS:-500000}"
export SEEDS="${SEEDS:-1}"
export PYTHON_EXE="${PYTHON_EXE:-python}"
export SAVE_MODEL="${SAVE_MODEL:-1}"

bash gym_sokoban/run_all_sequential.sh
